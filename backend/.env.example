# SAM 2 Checkpoint path (relative to backend folder or absolute path)
SAM2_CHECKPOINT=./checkpoints/sam2.1_hiera_base_plus.pt

# SAM 2 Model configuration file
SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_b+.yaml

# Temporary directory where video frames and outputs are processed and stored
SESSIONS_DIR=./tmp/sessions

# Maximum session age in hours before the cleanup service deletes it
MAX_SESSION_AGE_HOURS=2

# Maximum uploaded file size in MB
MAX_UPLOAD_SIZE_MB=500

# Backend port to run the FastAPI server on
PORT=8000
